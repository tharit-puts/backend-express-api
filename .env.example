# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้ ห้าม commit)

# Connection string ของ Supabase (เอาจาก Project Settings > Database > Connection string > URI)
# อย่าลืมแทน [YOUR-PASSWORD] ด้วยรหัสผ่าน database จริง
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# กุญแจสำหรับเซ็น JWT — ต้องเป็นค่าสุ่มยาว ๆ และเก็บเป็นความลับ
JWT_SECRET=เปลี่ยนเป็นค่าสุ่มของตัวเอง

# อายุของ token
JWT_EXPIRES_IN=7d

PORT=4000
